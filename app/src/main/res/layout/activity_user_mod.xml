<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".UserModActivity">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_main_rounded"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:background="@android:color/transparent"
            android:scaleX="2"
            android:scaleY="2"
            android:src="@drawable/back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/username_mod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:paddingBottom="10dp"
            android:text=""
            android:textColor="@color/text_color"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>


    <Button
        android:id="@+id/dot0"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/button"
        android:clickable="false"
        android:text=""
        app:layout_constraintBottom_toBottomOf="@id/sopsendi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/sopsendi" />


    <TextView
        android:id="@+id/sopsendi"
        style="@style/MainText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/suspend_user_btn"
        android:textColor="@color/black"
        android:layout_marginStart="10dp"
        android:layout_marginTop="25dp"
        android:textSize="30sp"
        app:layout_constraintStart_toEndOf="@id/dot0"
        app:layout_constraintTop_toBottomOf="@id/top_layout" />

    <Switch
        android:id="@+id/sosp_switch"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/sopsendi"
        app:layout_constraintStart_toEndOf="@id/sopsendi"
        app:layout_constraintTop_toTopOf="@+id/sopsendi" />

    <Button
        android:id="@+id/dot1"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/button"
        android:clickable="false"
        android:text=""
        app:layout_constraintBottom_toBottomOf="@id/blocca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/blocca" />

    <TextView
        android:id="@+id/blocca"
        style="@style/MainText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="25dp"
        android:text="@string/block_user_btn"
        android:textColor="@color/black"
        android:textSize="30sp"
        app:layout_constraintStart_toEndOf="@id/dot1"
        app:layout_constraintTop_toBottomOf="@id/sopsendi" />

    <Switch
        android:id="@+id/bann_switch"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/blocca"
        app:layout_constraintStart_toStartOf="@id/sosp_switch"
        app:layout_constraintTop_toTopOf="@+id/blocca" />


    <Button
        android:id="@+id/dot2"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/button"
        android:clickable="false"
        android:text=""
        app:layout_constraintBottom_toBottomOf="@id/chat_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/chat_btn" />

    <Button
        android:id="@+id/chat_btn"
        style="@style/smallButtonStyle"
        android:layout_width="180dp"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="10dp"
        android:text="CHAT"
        android:layout_marginBottom="25dp"
        app:layout_constraintStart_toEndOf="@id/dot2"
        app:layout_constraintTop_toBottomOf="@+id/blocca" />

    <Button
        android:id="@+id/dot3"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/button"
        android:clickable="false"
        android:text=""
        app:layout_constraintBottom_toBottomOf="@id/delete_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/delete_btn" />

    <Button
        android:id="@+id/delete_btn"
        style="@style/smallButtonStyle"
        android:layout_width="180dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="10dp"
        android:text="@string/delete_user_admin_btn"
        android:layout_marginBottom="25dp"
       app:layout_constraintStart_toEndOf="@id/dot3"
        app:layout_constraintTop_toBottomOf="@+id/chat_btn" />

    <Button
        android:id="@+id/mod_btn"
        style="@style/smallButtonStyle"
        android:layout_width="320dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="@string/apply_user_modification"
        android:layout_marginBottom="25dp"
        app:cornerRadius="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>