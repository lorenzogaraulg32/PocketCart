<resources>
    <!-- Base application theme. -->
    <style name="Theme.EbayClone" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="statusBarBackground">@color/colorPrimary</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="InputError">
        <item name="android:text">@string/err_not_empty</item>
        <item name="android:textAlignment">textStart</item>
        <item name="android:textColor">@color/red_err</item>
        <item name="android:visibility">invisible</item>
    </style>

    <style name="Title">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">25sp</item>
    </style>

    <style name="MainText">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MainTextDark">
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SmallText">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">16sp</item>
    </style>


    <style name="SecondaryText">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ThirdText">
        <item name="android:textColor">@color/text_color2</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="SmallBtn">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="dialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in</item>
        <item name="android:windowExitAnimation">@anim/slide_out</item>
    </style>

    <style name="InputEditText" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:background">@drawable/bg_text_field</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textColorHint">@color/text_color</item>
    </style>

    <style name="InputEditTextLigth" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:background">@drawable/bg_text_field_ligth</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
    </style>


    <style name="InputEditTextChat" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:background">@drawable/bg_text_field</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textColorHint">@color/text_color2</item>
    </style>

    <style name="InputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:textColorHint">"@color/text_color"</item>
        <item name="hintTextColor">@color/text_color</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
    </style>

    <style name="InputLayoutLigth" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:textColorHint">"@color/black"</item>
        <item name="hintTextColor">@color/black</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
    </style>



    <style name="smallButtonStyle">
        <item name="android:background">@drawable/small_btn_background</item>
        <item name="android:textColor">@color/text_color</item>
    </style>


    <style name="button" parent="@android:style/Widget.Button">
        <item name="android:gravity">center_vertical|center_horizontal</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/button</item>
    </style>

    <style name="button2" parent="@android:style/Widget.Button">
        <item name="android:gravity">center_vertical|center_horizontal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/button2</item>
    </style>


    <style name="buttonSwitch" parent="@android:style/Widget.Button">
        <item name="android:gravity">center_vertical|center_horizontal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/button_switch</item>
    </style>


    <style name="spinnerDropDownItemStyle" parent="android:TextAppearance.Widget.TextView.SpinnerItem">
        <item name="android:textColor">@color/text_color</item>
        <item name="strokeColor">@color/white</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:background">@color/input_color_focussed</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:padding">2dp</item>
        <item name="android:textSize">20sp</item>
    </style>


    <style name="SubTitle">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>